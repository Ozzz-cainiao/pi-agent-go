  "expected": {
    "events": ["agent_start", "turn_start", "message_start", "message_end", "message_start", "message_end", "tool_execution_start", "tool_execution_start", "tool_execution_end", "tool_execution_end", "message_start", "message_end", "message_start", "message_end", "turn_end", "turn_start", "message_start", "message_end", "turn_end", "agent_end"],
    "messages": [
      {"role": "user", "text": "并行查询"},
      {"role": "assistant", "tool_calls": [
